# انسخ هذا الملف إلى .env وعدّل القيم

# منفذ الخادم (اختياري، الافتراضي 3000)
PORT=3000

# سرّ توقيع تسجيل الدخول (JWT) — غيّره إلى نص عشوائي طويل في بيئة الإنتاج
SESSION_SECRET=change-this-to-a-random-long-secret

# رابط وتوكن قاعدة بيانات Turso السحابية (مطلوبة عند الاستضافة على Vercel).
# اتركها فارغة للتشغيل المحلي فقط — سيُنشئ التطبيق عندها قاعدة بيانات محلية
# تلقائياً في مجلد data/. على الاستضافة الحقيقية (Vercel) لا بد من ضبطهما
# لأن القرص المحلي هناك غير دائم بين الطلبات.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# بيانات بوت تلغرام للأرشفة (اختياري)
# احصل على التوكن من BotFather على تلغرام
TELEGRAM_BOT_TOKEN=
# معرّف القناة/المجموعة/المحادثة التي سيتم إرسال الأرشيف إليها
TELEGRAM_CHAT_ID=
